<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>GodHand_TurretBase</defName>
    <label>Disintegrating Turret Base</label>
    <description>The remaining base wreckage after the God Hand pulled off the turret head. The structure is unstable and about to disintegrate.</description>
    <thingClass>GodHandMod.GodHandTurretBase</thingClass>
    <graphicData>
      <texPath>Things/Building/Security/TurretMini_Base</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1</drawSize>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <fillPercent>0.2</fillPercent>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <Flammability>0</Flammability>
    </statBases>
    <selectable>false</selectable>
    <rotatable>true</rotatable>
    <tickerType>Normal</tickerType>
    <!-- 禁止各种交互，避免寻路问题 -->
    <canOverlapZones>true</canOverlapZones>
    <neverMultiSelect>true</neverMultiSelect>
    <useHitPoints>true</useHitPoints>
    <destroyable>true</destroyable>
  </ThingDef>
</Defs>

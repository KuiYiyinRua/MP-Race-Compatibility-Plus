<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 摸头动画Mote -->
  <ThingDef ParentName="MoteBase">
    <defName>Mote_HeadPat</defName>
    <thingClass>GodHandMod.MoteHeadPat</thingClass>
    <graphicData>
      <!-- 占位纹理路径，实际在代码中加载gif，不使用这个纹理 -->
      <texPath>Things/Mote/AirPuff</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
    </graphicData>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <mote>
      <fadeInTime>0.1</fadeInTime>
      <solidTime>2.0</solidTime>
      <fadeOutTime>0.5</fadeOutTime>
    </mote>
  </ThingDef>

  <!-- 神之裁决降落 Mote -->
  <ThingDef ParentName="MoteBase">
    <defName>Mote_GodJudgmentFalling</defName>
    <thingClass>GodHandMod.MoteGodJudgment</thingClass>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>UI/Designators/GodJudgment</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>MoteGlow</shaderType>
      <drawSize>10</drawSize>
    </graphicData>
    <altitudeLayer>Skyfaller</altitudeLayer><!-- 使用Skyfaller层级，专门用于从天空掉落的物体 -->
    <mote>
      <fadeInTime>0</fadeInTime>
      <solidTime>999</solidTime>
      <fadeOutTime>0</fadeOutTime>
    </mote>
  </ThingDef>
</Defs>

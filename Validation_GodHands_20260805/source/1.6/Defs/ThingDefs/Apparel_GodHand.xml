<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="ApparelBase">
    <defName>GodHand_TurretHead</defName>
    <label>Turret Headpiece</label>
    <description>The top of a turret torn off by the God Hand, now it's a stylish hat.\n\nWarning: This might make you look like a mobile fortification.</description>
    <smeltable>false</smeltable>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/SimpleHelmet/SimpleHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingClass>GodHandMod.GodHandTurretHead</thingClass>
    <tickerType>Normal</tickerType>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>1000</WorkToMake>
      <Mass>5</Mass>
      <EquipDelay>0.5</EquipDelay>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>UpperHead</li>
        <li>FullHead</li>
      </bodyPartGroups>
      <layers>
        <li>Overhead</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(0.9,0.9,0.9)</only>
        </li>
      </options>
    </colorGenerator>
  </ThingDef>
</Defs>

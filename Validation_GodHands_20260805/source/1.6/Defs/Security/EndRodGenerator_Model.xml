<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <GodHandMod.ModelDef>
    <defName>GodHand_EndRodGenerator</defName>
    <textures>
      <!-- 活塞 & 侦测器 -->
      <li><key>piston_side</key><path>CreateAssets/Minecraft/piston_side</path></li>
      <li><key>piston_top</key><path>CreateAssets/Minecraft/piston_top</path></li>
      <li><key>piston_bottom</key><path>CreateAssets/Minecraft/piston_bottom</path></li>
      <li><key>piston_inner</key><path>CreateAssets/Minecraft/piston_inner</path></li>
      <li><key>observer_front</key><path>CreateAssets/Minecraft/observer_front</path></li>
      <li><key>observer_back</key><path>CreateAssets/Minecraft/observer_back</path></li>
      <li><key>observer_side</key><path>CreateAssets/Minecraft/observer_side</path></li>
      <li><key>observer_top</key><path>CreateAssets/Minecraft/observer_top</path></li>
      <li><key>end_rod</key><path>CreateAssets/Minecraft/end_rod</path></li>
      <li><key>boat_oak</key><path>CreateAssets/Minecraft/boat_oak</path></li>
    </textures>
    <elements>
      <!-- ========================================== -->
      <!-- 1. 侦测器时钟组 (Observers) - 占地 2 格 (0-32) -->
      <!-- 位于最南端 (Z=0) 向北看 -->
      <!-- ========================================== -->
      <!-- 侦测器 1：面北 (Z+) - 原始方向 -->
      <li>
        <name>Observer_1</name>
        <from>(0, 0, 0)</from>
        <to>(16, 16, 16)</to>
        <rotation>
          <origin>(8, 8, 8)</origin> <!-- 绕自身中心旋转 -->
          <axis>y</axis>
          <angle>180</angle>
        </rotation>
        <faces>
          <north> <uv>(0, 0, 16, 16)</uv> <texture>observer_front</texture> </north>
          <east> <uv>(0, 0, 16, 16)</uv> <texture>observer_side</texture> </east>
          <south> <uv>(0, 0, 16, 16)</uv> <texture>observer_back</texture> </south>
          <west> <uv>(0, 0, 16, 16)</uv> <texture>observer_side</texture> </west>
          <up> <uv>(0, 0, 16, 16)</uv> <texture>observer_top</texture> </up>
          <down> <uv>(0, 0, 16, 16)</uv> <texture>observer_top</texture> </down>
        </faces>
      </li>
      <!-- 侦测器 2：面南 (Z-) - 通过旋转实现 -->
      <li>
        <name>Observer_2</name>
        <from>(0, 0, 16)</from>
        <to>(16, 16, 32)</to>
        <faces>
          <!-- 定义为标准北向，旋转后 Front 将朝南 -->
          <north> <uv>(0, 0, 16, 16)</uv> <texture>observer_front</texture> </north>
          <east> <uv>(0, 0, 16, 16)</uv> <texture>observer_side</texture> </east>
          <south> <uv>(0, 0, 16, 16)</uv> <texture>observer_back</texture> </south>
          <west> <uv>(0, 0, 16, 16)</uv> <texture>observer_side</texture> </west>
          <up> <uv>(0, 0, 16, 16)</uv> <texture>observer_top</texture> </up>
          <down> <uv>(0, 0, 16, 16)</uv> <texture>observer_top</texture> </down>
        </faces>
      </li>

      <!-- ========================================== -->
      <!-- 2. 活塞底座 (Piston Base - Extended State) - 12 像素高 -->
      <!-- 位于 Z=32 到 Z=44 -->
      <!-- ========================================== -->

      <li>
        <name>Piston_Base</name>
        <from>(0, 0, 32)</from>
        <to>(16, 16, 44)</to>
        <faces>
          <north> <uv>(0, 0, 16, 16)</uv> <texture>piston_inner</texture> </north> <!-- 伸出后露出的内部 -->
          <east> <uv>(0, 4, 16, 16)</uv> <rotation>90</rotation> <texture>piston_side</texture> </east>
          <south> <uv>(0, 0, 16, 16)</uv> <texture>piston_bottom</texture> </south> <!-- 固定端 -->
          <west> <uv>(0, 4, 16, 16)</uv> <rotation>270</rotation> <texture>piston_side</texture> </west>
          <up> <uv>(0, 4, 16, 16)</uv> <rotation>180</rotation> <texture>piston_side</texture> </up>
          <down> <uv>(0, 4, 16, 16)</uv> <texture>piston_side</texture> </down>
        </faces>
      </li>

      <!-- ========================================== -->
      <!-- 3. 动态部分 (北向推进) -->
      <!-- ========================================== -->
      <!-- 活塞推板 (Piston Platform) - 4 像素厚 -->
      <li>
        <name>Piston_Head</name>
        <from>(0, 0, 44)</from>
        <to>(16, 16, 48)</to>
        <faces>
          <north> <uv>(0, 0, 16, 16)</uv> <texture>piston_top</texture> </north> <!-- 推面 -->
          <east> <uv>(0, 0, 16, 4)</uv> <rotation>90</rotation> <texture>piston_side</texture> </east>
          <south> <uv>(0, 0, 16, 16)</uv> <texture>piston_top</texture> </south> <!-- 反面木纹 -->
          <west> <uv>(0, 0, 16, 4)</uv> <rotation>270</rotation> <texture>piston_side</texture> </west>
          <up> <uv>(0, 0, 16, 4)</uv> <rotation>180</rotation> <texture>piston_side</texture> </up>
          <down> <uv>(0, 0, 16, 4)</uv> <texture>piston_side</texture> </down>
        </faces>
      </li>
      <!-- 活塞连接杆 (Piston Rod) - 16 像素长，深入底座 -->
      <li>
        <name>Piston_Rod</name>
        <from>(6, 6, 28)</from>
        <to>(10, 10, 44)</to>
        <faces>
           <east> <uv>(0, 0, 16, 4)</uv> <texture>piston_side</texture> </east>
           <west> <uv>(0, 0, 16, 4)</uv> <texture>piston_side</texture> </west>
           <up> <uv>(0, 0, 16, 4)</uv> <rotation>270</rotation> <texture>piston_side</texture> </up>
           <down> <uv>(0, 0, 16, 4)</uv> <rotation>90</rotation> <texture>piston_side</texture> </down>
        </faces>
      </li>
      <!-- 末端烛 (End Rod) - 由底座和烛体组成 -->
      <!-- 烛体 (Rod): 2x2x15, 对应 Z=48+4=52 到 63? 
           Original JSON: from 7,1,7 to 9,16,9. (2x15x2). 
           Shifted directly to match Piston Head center?
           Piston Head ends at Z=48.
           End Rod base starts.
           Let's place Base at Z=48 (thickness 1), Rod at Z=49 (length 15).
           Center X/Y is 8. Rod is 2 wide -> 7 to 9.
      -->
      <!-- Base: 4x4x1 (Original 6,0,6 to 10,1,10) -->
      <li>
        <name>End_Rod</name>
        <from>(6, 6, 48)</from>
        <to>(10, 10, 49)</to> <!-- 1 pixel thick base -->
        <faces>
           <!-- Base UVs from JSON: down 6,6,2,2; up 2,2,6,6; sides 2,6,6,7 -->
           <!-- Mapping to 16x16 sheet -->
           <north> <uv>(2, 6, 6, 7)</uv> <texture>end_rod</texture> </north>
           <east> <uv>(2, 6, 6, 7)</uv> <texture>end_rod</texture> </east>
           <south> <uv>(2, 6, 6, 7)</uv> <texture>end_rod</texture> </south>
           <west> <uv>(2, 6, 6, 7)</uv> <texture>end_rod</texture> </west>
           <up> <uv>(2, 2, 6, 6)</uv> <texture>end_rod</texture> </up>
           <!-- Hidden by Piston Head usually, but defines it anyway -->
           <down> <uv>(2, 2, 6, 6)</uv> <texture>end_rod</texture> </down> 
        </faces>
      </li>
      <li>
        <name>End_Rod</name>
        <from>(7, 7, 49)</from>
        <to>(9, 9, 64)</to> <!-- 15 pixels long -->
        <faces>
           <!-- Rod UVs: sides 0,0,2,15; up 2,0,4,2 -->
           <north> <uv>(0, 0, 2, 15)</uv> <texture>end_rod</texture> </north>
           <!-- Rotate side textures to match vertical rod -->
           <east> <uv>(0, 0, 2, 15)</uv> <texture>end_rod</texture> </east>
           <south> <uv>(0, 0, 2, 15)</uv> <texture>end_rod</texture> </south>
           <west> <uv>(0, 0, 2, 15)</uv> <texture>end_rod</texture> </west>
           
           <up> <uv>(2, 0, 4, 2)</uv> <texture>end_rod</texture> </up>
           <down> <uv>(2, 0, 4, 2)</uv> <texture>end_rod</texture> </down>
        </faces>
      </li>

      <!-- ========================================== -->
      <!-- 4. 船 (Boat) - 使用 OBJ 模型 -->
      <!-- ========================================== -->
      <li>
        <name>Boat</name>
        <objPath>boat/source/boat.obj</objPath>
        <objScale>24</objScale>
        <!-- 几何中心定位：X=8(居中), Y=8(高度), Z=72(活塞末端前方) -->
        <from>(8, 8, 68)</from>
        <!-- 修正朝向：旋转 90 度以匹配红框方向 -->
        <rotation>
          <origin>(0, 0, 0)</origin>
          <axis>y</axis>
          <angle>90</angle>
        </rotation>
        <faces>
          <north> <texture>boat_oak</texture> </north>
        </faces>
      </li>
    </elements>
  </GodHandMod.ModelDef>
</Defs>

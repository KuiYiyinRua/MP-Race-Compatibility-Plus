<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <!-- 装填迫击炮弹药 -->
  <JobDef>
    <defName>GodHand_ReloadTurretHead</defName>
    <driverClass>GodHandMod.JobDriver_ReloadTurretHead</driverClass>
    <reportString>Reloading turret ammo.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
  
  <!-- 补充炮塔燃料/炮管 -->
  <JobDef>
    <defName>GodHand_RefuelTurretHead</defName>
    <driverClass>GodHandMod.JobDriver_RefuelTurretHead</driverClass>
    <reportString>Refueling turret.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
  
  <!-- 合并炮塔头 -->
  <JobDef>
    <defName>GodHand_MergeTurretHead</defName>
    <driverClass>GodHandMod.JobDriver_MergeTurretHead</driverClass>
    <reportString>Merging turret head.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
  
  <!-- 安装炮塔模块 -->
  <JobDef>
    <defName>GodHand_InstallTurretModule</defName>
    <driverClass>GodHandMod.JobDriver_InstallTurretModule</driverClass>
    <reportString>Installing turret module.</reportString>
    <casualInterruptible>false</casualInterruptible>
  </JobDef>
</Defs>

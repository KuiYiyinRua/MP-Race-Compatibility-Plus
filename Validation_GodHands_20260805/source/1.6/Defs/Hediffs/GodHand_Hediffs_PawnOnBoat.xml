<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>GodHand_IsActuallyABoat</defName>
    <label>Actually a Boat</label>
    <description>This pawn is fixed to a boat and cannot move independently.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.8, 0.8)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <!-- 标记组件，暂无特殊逻辑 -->
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>GodHand_OrificeStretchingStatus</defName>
    <label>Stretching Status</label>
    <description>Due to prolonged physical filling from extremely large-sized objects, this unit's physiological structure is undergoing deep, or even permanent, reshaping.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.4, 0.9)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <stages>
      <li>
        <label>Tight</label>
      </li>
      <li>
        <minSeverity>0.3</minSeverity>
        <label>Adapted</label>
      </li>
      <li>
        <minSeverity>0.6</minSeverity>
        <label>Fully Relaxed</label>
      </li>
      <li>
        <minSeverity>0.9</minSeverity>
        <label>Fully Damaged</label>
      </li>
    </stages>
    <comps>
      <li Class="GodHandMod.HediffCompProperties_GodHandBoatAdaptation" />
      <li Class="HediffCompProperties_GetsPermanent">
        <permanentLabel>Permanent Stretching</permanentLabel>
      </li>
    </comps>
  </HediffDef>
</Defs>

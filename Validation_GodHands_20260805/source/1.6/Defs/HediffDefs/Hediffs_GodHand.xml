<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>GodHand_ForcedDowned</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.6, 0.8)</defaultLabelColor>
    <isBad>false</isBad>
    <initialSeverity>1</initialSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>
          <min>2500</min> <!-- 1小时 = 2500 ticks -->
          <max>2500</max>
        </disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <label>Forced Downed</label>
    <description>This unit has been forced into a downed state by the God Hand. It is unable to move for a short duration.</description>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  <HediffDef>
    <defName>GodHand_StasisLock</defName>
    <label>Stasis Lock</label>
    <description>The target's temporal phase is forcibly locked in a rift within the field of interference. All its vital signs and bioelectrical currents will be anchored at the critical point of absolute stasis (1%), detached from the flow of conventional time dimensions. The effect lasts for 24 hours.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.5, 0.1, 0.1)</defaultLabelColor>
    <isBad>true</isBad>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks> <!-- 1天 -->
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <hungerRateFactor>0</hungerRateFactor>
        <capMods>
          <li><capacity>Consciousness</capacity><setMax>0.01</setMax></li>
          <li><capacity>Moving</capacity><setMax>0.01</setMax></li>
          <li><capacity>Manipulation</capacity><setMax>0.01</setMax></li>
          <li><capacity>Talking</capacity><setMax>0.01</setMax></li>
          <li><capacity>Eating</capacity><setMax>0.01</setMax></li>
          <li><capacity>Sight</capacity><setMax>0.01</setMax></li>
          <li><capacity>Hearing</capacity><setMax>0.01</setMax></li>
          <li><capacity>Breathing</capacity><setMax>0.01</setMax></li>
          <li><capacity>BloodPumping</capacity><setMax>0.01</setMax></li>
          <li><capacity>BloodFiltration</capacity><setMax>0.01</setMax></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>

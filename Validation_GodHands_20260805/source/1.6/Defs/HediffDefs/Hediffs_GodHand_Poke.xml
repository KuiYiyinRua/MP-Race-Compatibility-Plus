<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>GodHand_PokedHead</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(1, 0.2, 0.2)</defaultLabelColor>
    <label>Poked Head</label>
    <description>The head has been poked by the God Hand, causing disorientation and pain.</description>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-10.0</severityPerDay> <!-- Disappears quickly -->
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.1</minSeverity>
        <painOffset>0.1</painOffset>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <painOffset>0.25</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.1</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.8</minSeverity>
        <painOffset>0.4</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.2</offset>
          </li>
        </capMods>
        <vomitMtbDays>0.1</vomitMtbDays>
      </li>
    </stages>
  </HediffDef>
</Defs>

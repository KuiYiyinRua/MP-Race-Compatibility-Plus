<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <GodHandMod.ModelDef>
    <defName>GodHand_HandCrank</defName>
    <textures>
      <!-- Key to Texture Path mapping. Paths are relative to Textures/ -->
      <!-- create:block/axis -> CreateAssets/Textures/white (placeholder or real path) -->
      <!-- We assume textures are at Textures/CreateAssets/Textures/ -->
      <li><key>#0</key><path>CreateAssets/axis</path></li>
      <li><key>#1</key><path>CreateAssets/axis_top</path></li>
      <li><key>#2</key><path>CreateAssets/andesite_casing_short</path></li>
      <li><key>#4</key><path>CreateAssets/smooth_dark_log_top</path></li>
    </textures>
    <elements>
      <!-- Element: Axis -->
      <li>
        <name>Axis</name>
        <from>(6, 6, 11)</from>
        <to>(10, 10, 16)</to>
        <faces>
          <east> <uv>(6, 0, 10, 5)</uv> <rotation>270</rotation> <texture>#0</texture> </east>
          <south> <uv>(6, 6, 10, 10)</uv> <texture>#1</texture> </south>
          <west> <uv>(6, 0, 10, 5)</uv> <rotation>90</rotation> <texture>#0</texture> </west>
          <up> <uv>(6, 0, 10, 5)</uv> <rotation>180</rotation> <texture>#0</texture> </up>
          <down> <uv>(6, 0, 10, 5)</uv> <texture>#0</texture> </down>
        </faces>
      </li>
      <!-- Element: Connector -->
      <li>
        <name>Connector</name>
        <from>(5, 5, 11)</from>
        <to>(11, 11, 14)</to>
        <faces>
          <north> <uv>(5, 5, 11, 11)</uv> <texture>#4</texture> </north>
          <east> <uv>(13, 5, 16, 11)</uv> <texture>#4</texture> </east>
          <south> <uv>(5, 5, 11, 11)</uv> <texture>#4</texture> </south>
          <west> <uv>(0, 5, 3, 11)</uv> <texture>#4</texture> </west>
          <up> <uv>(5, 0, 11, 3)</uv> <texture>#4</texture> </up>
          <down> <uv>(4, 13, 10, 16)</uv> <texture>#4</texture> </down>
        </faces>
      </li>
      <!-- Element: Arm_Head (Fixed Base) -->
      <li>
        <name>Arm_Head</name>
        <from>(-2, 6, 10)</from>
        <to>(6, 10, 13)</to>
        <faces>
          <north> <uv>(0, 6, 8, 10)</uv> <texture>#2</texture> </north>
          <!-- No East Face (Internal) -->
          <south> <uv>(0, 6, 8, 10)</uv> <texture>#2</texture> </south>
          <west> <uv>(0, 0, 4, 3)</uv> <rotation>90</rotation> <texture>#2</texture> </west>
          <up> <uv>(0, 6, 8, 9)</uv> <texture>#2</texture> </up>
          <down> <uv>(0, 6, 8, 9)</uv> <texture>#2</texture> </down>
        </faces>
      </li>
      <!-- Element: Arm_Body (Stretches) -->
      <li>
        <name>Arm_Body</name>
        <from>(6, 6, 10)</from>
        <to>(7, 10, 13)</to>
        <faces>
          <north> <uv>(8, 6, 9, 10)</uv> <texture>#2</texture> </north>
          <south> <uv>(8, 6, 9, 10)</uv> <texture>#2</texture> </south>
          <up> <uv>(8, 6, 9, 9)</uv> <texture>#2</texture> </up>
          <down> <uv>(8, 6, 9, 9)</uv> <texture>#2</texture> </down>
        </faces>
      </li>
      <!-- Element: Arm_Tail (Moves with Extension) -->
      <li>
        <name>Arm_Tail</name>
        <from>(7, 6, 10)</from>
        <to>(14, 10, 13)</to>
        <faces>
          <north> <uv>(9, 6, 16, 10)</uv> <texture>#2</texture> </north>
          <east> <uv>(0, 0, 4, 3)</uv> <rotation>90</rotation> <texture>#2</texture> </east>
          <south> <uv>(9, 6, 16, 10)</uv> <texture>#2</texture> </south>
          <!-- No West Face (Internal) -->
          <up> <uv>(9, 6, 16, 9)</uv> <texture>#2</texture> </up>
          <down> <uv>(9, 6, 16, 9)</uv> <texture>#2</texture> </down>
        </faces>
      </li>
      <!-- Element: Connector 2 -->
      <li>
        <name>Connector2</name>
        <from>(0, 7, 9)</from>
        <to>(2, 9, 10)</to>
        <rotation>
          <origin>(9, 8, 9)</origin>
          <axis>y</axis>
          <angle>0</angle>
        </rotation>
        <faces>
          <north> <uv>(0, 0, 2, 2)</uv> <texture>#2</texture> </north>
          <east> <uv>(0, 0, 1, 2)</uv> <texture>#2</texture> </east>
          <south> <uv>(0, 0, 2, 2)</uv> <texture>#2</texture> </south>
          <west> <uv>(0, 0, 1, 2)</uv> <texture>#2</texture> </west>
          <up> <uv>(0, 0, 2, 1)</uv> <texture>#2</texture> </up>
          <down> <uv>(0, 0, 2, 1)</uv> <texture>#2</texture> </down>
        </faces>
      </li>
      <!-- Element: Grip -->
      <li>
        <name>Grip</name>
        <from>(-0.5, 6.5, 3)</from>
        <to>(2.5, 9.5, 9)</to>
        <rotation>
          <origin>(1, 8, 9)</origin>
          <axis>z</axis>
          <angle>45</angle>
        </rotation>
        <faces>
          <north> <uv>(6, 11, 9, 14)</uv> <rotation>90</rotation> <texture>#0</texture> </north>
          <east> <uv>(7, 1, 10, 7)</uv> <rotation>90</rotation> <texture>#0</texture> </east>
          <south> <uv>(7, 5, 10, 8)</uv> <texture>#0</texture> </south>
          <west> <uv>(7, 1, 10, 7)</uv> <rotation>90</rotation> <texture>#0</texture> </west>
          <up> <uv>(7, 1, 10, 7)</uv> <texture>#0</texture> </up>
          <down> <uv>(7, 1, 10, 7)</uv> <texture>#0</texture> </down>
        </faces>
      </li>
    </elements>
  </GodHandMod.ModelDef>
</Defs>

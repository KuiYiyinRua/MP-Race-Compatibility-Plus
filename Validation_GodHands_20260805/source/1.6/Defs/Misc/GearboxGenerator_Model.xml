<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <GodHandMod.ModelDef>
    <defName>GodHand_GearboxGenerator</defName>
    <textures>
      <li><key>andesite_casing</key><path>CreateAssets/andesite_casing</path></li>
      <li><key>gearbox</key><path>CreateAssets/gearbox</path></li>
      <li><key>gearbox_top</key><path>CreateAssets/gearbox_top</path></li>
      <li><key>axis</key><path>CreateAssets/axis</path></li>
      <li><key>andesite_casing_short</key><path>CreateAssets/andesite_casing_short</path></li>
      <li><key>smooth_dark_log_top</key><path>CreateAssets/smooth_dark_log_top</path></li>
    </textures>
    <elements>
      <!-- 齿轮箱底座 (Housing) - 对应 C# 中的 Housing 层 -->
      <li>
        <name>Housing_Bottom</name>
        <from>(0, 0, 0)</from>
        <to>(16, 2, 16)</to>
        <faces>
          <north> <uv>(0, 14, 16, 16)</uv> <texture>andesite_casing</texture> </north>
          <east> <uv>(0, 14, 16, 16)</uv> <texture>andesite_casing</texture> </east>
          <south> <uv>(0, 14, 16, 16)</uv> <texture>andesite_casing</texture> </south>
          <west> <uv>(0, 14, 16, 16)</uv> <texture>andesite_casing</texture> </west>
          <up> <uv>(0, 0, 16, 16)</uv> <texture>andesite_casing</texture> </up>
          <down> <uv>(0, 0, 16, 16)</uv> <texture>andesite_casing</texture> </down>
        </faces>
      </li>
      <li>
        <name>Housing_Core</name>
        <from>(0.95, 2, 0.95)</from>
        <to>(15.05, 14, 15.05)</to>
        <faces>
          <north> <uv>(1, 2, 15, 14)</uv> <texture>gearbox</texture> </north>
          <east> <uv>(1, 2, 15, 14)</uv> <texture>gearbox</texture> </east>
          <south> <uv>(1, 2, 15, 14)</uv> <texture>gearbox</texture> </south>
          <west> <uv>(1, 2, 15, 14)</uv> <texture>gearbox</texture> </west>
        </faces>
      </li>
      <li>
        <name>Housing_Top</name>
        <from>(0, 14, 0)</from>
        <to>(16, 16, 16)</to>
        <faces>
          <north> <uv>(0, 0, 16, 2)</uv> <texture>andesite_casing</texture> </north>
          <east> <uv>(0, 0, 16, 2)</uv> <texture>andesite_casing</texture> </east>
          <south> <uv>(0, 0, 16, 2)</uv> <texture>andesite_casing</texture> </south>
          <west> <uv>(0, 0, 16, 2)</uv> <texture>andesite_casing</texture> </west>
          <up> <uv>(0, 0, 16, 16)</uv> <texture>gearbox_top</texture> </up>
          <down> <uv>(0, 0, 16, 16)</uv> <texture>andesite_casing</texture> </down>
        </faces>
      </li>

      <!-- Shaft_Internal: 内部传动轴 (纵向 Z 轴) - 拆分为两段以支持镜像旋转 -->
      <li>
        <name>Shaft_Internal_Back</name> <!-- 连接手柄端，正向 -->
        <from>(6.5, 6.5, 8)</from>
        <to>(9.5, 9.5, 14)</to>
        <faces>
          <north> <uv>(6, 8, 10, 14)</uv> <texture>axis</texture> </north>
          <east> <uv>(6, 8, 10, 14)</uv> <texture>axis</texture> </east>
          <south> <uv>(6, 8, 10, 14)</uv> <texture>axis</texture> </south>
          <west> <uv>(6, 8, 10, 14)</uv> <texture>axis</texture> </west>
          <up> <uv>(6, 0, 10, 14)</uv> <texture>axis</texture> </up>
          <down> <uv>(6, 0, 10, 14)</uv> <texture>axis</texture> </down>
        </faces>
      </li>
      <li>
        <name>Shaft_Internal_Front_Reverse</name> <!-- 对面端，反向 -->
        <from>(6.5, 6.5, 0)</from>
        <to>(9.5, 9.5, 8)</to>
        <faces>
          <north> <uv>(6, 0, 10, 8)</uv> <texture>axis</texture> </north>
          <east> <uv>(6, 0, 10, 8)</uv> <texture>axis</texture> </east>
          <south> <uv>(6, 0, 10, 8)</uv> <texture>axis</texture> </south>
          <west> <uv>(6, 0, 10, 8)</uv> <texture>axis</texture> </west>
          <up> <uv>(6, 0, 10, 14)</uv> <texture>axis</texture> </up>
          <down> <uv>(6, 0, 10, 14)</uv> <texture>axis</texture> </down>
        </faces>
      </li>
      <!-- Shaft_Horizontal: 采用旋转标准纵向轴体的方案，修复 UV 逻辑 -->
      <li>
        <name>Shaft_Horizontal_Left</name>
        <from>(6.5, 6.5, 8)</from>
        <to>(9.5, 9.5, 16)</to>
        <rotation>
          <origin>(8, 8, 8)</origin>
          <axis>y</axis>
          <angle>90</angle>
        </rotation>
        <faces>
          <north> <uv>(6.5, 6.5, 9.5, 9.5)</uv> <texture>axis</texture> </north>
          <east> <uv>(6.5, 8, 9.5, 16)</uv> <texture>axis</texture> </east>
          <south> <uv>(6.5, 6.5, 9.5, 9.5)</uv> <texture>axis</texture> </south>
          <west> <uv>(6.5, 8, 9.5, 16)</uv> <texture>axis</texture> </west>
          <up> <uv>(6.5, 8, 9.5, 16)</uv> <texture>axis</texture> </up>
          <down> <uv>(6.5, 8, 9.5, 16)</uv> <texture>axis</texture> </down>
        </faces>
      </li>
      <li>
        <name>Shaft_Horizontal_Right_Reverse</name>
        <from>(6.5, 6.5, 0)</from>
        <to>(9.5, 9.5, 8)</to>
        <rotation>
          <origin>(8, 8, 8)</origin>
          <axis>y</axis>
          <angle>90</angle>
        </rotation>
        <faces>
          <north> <uv>(6.5, 6.5, 9.5, 9.5)</uv> <texture>axis</texture> </north>
          <east> <uv>(6.5, 0, 9.5, 8)</uv> <texture>axis</texture> </east>
          <south> <uv>(6.5, 6.5, 9.5, 9.5)</uv> <texture>axis</texture> </south>
          <west> <uv>(6.5, 0, 9.5, 8)</uv> <texture>axis</texture> </west>
          <up> <uv>(6.5, 0, 9.5, 8)</uv> <texture>axis</texture> </up>
          <down> <uv>(6.5, 0, 9.5, 8)</uv> <texture>axis</texture> </down>
        </faces>
      </li>
      <!-- 偏移量调整：将手柄从 (8,8,16) 开始向外延伸 -->
      <li>
        <name>Crank_Connector</name>
        <from>(5, 5, 14)</from>
        <to>(11, 11, 16.5)</to>
        <faces>
          <north> <uv>(5, 5, 11, 11)</uv> <texture>smooth_dark_log_top</texture> </north>
          <east> <uv>(13, 6, 16, 12)</uv> <texture>smooth_dark_log_top</texture> </east>
          <south> <uv>(5, 5, 11, 11)</uv> <texture>smooth_dark_log_top</texture> </south>
          <west> <uv>(0, 3, 3, 9)</uv> <texture>smooth_dark_log_top</texture> </west>
          <up> <uv>(6, 0, 12, 3)</uv> <texture>smooth_dark_log_top</texture> </up>
          <down> <uv>(6, 13, 12, 16)</uv> <texture>smooth_dark_log_top</texture> </down>
        </faces>
      </li>
      <li>
        <name>Crank_Arm</name>
        <from>(-2, 6, 16.5)</from>
        <to>(14, 10, 19.5)</to>
        <faces>
          <north> <uv>(0, 6, 16, 10)</uv> <texture>andesite_casing_short</texture> </north>
          <east> <uv>(0, 0, 4, 3)</uv> <rotation>90</rotation> <texture>andesite_casing_short</texture> </east>
          <south> <uv>(0, 6, 16, 10)</uv> <texture>andesite_casing_short</texture> </south>
          <west> <uv>(0, 0, 4, 3)</uv> <rotation>90</rotation> <texture>andesite_casing_short</texture> </west>
          <up> <uv>(0, 6, 16, 9)</uv> <texture>andesite_casing_short</texture> </up>
          <down> <uv>(0, 6, 16, 9)</uv> <texture>andesite_casing_short</texture> </down>
        </faces>
      </li>
      <li>
        <name>Crank_Grip_Connector</name>
        <from>(0, 7, 19.5)</from>
        <to>(2, 9, 20.5)</to>
        <faces>
          <north> <uv>(0, 0, 2, 2)</uv> <texture>andesite_casing_short</texture> </north>
          <east> <uv>(0, 0, 1, 2)</uv> <texture>andesite_casing_short</texture> </east>
          <south> <uv>(0, 0, 2, 2)</uv> <texture>andesite_casing_short</texture> </south>
          <west> <uv>(0, 0, 1, 2)</uv> <texture>andesite_casing_short</texture> </west>
          <up> <uv>(0, 0, 2, 1)</uv> <texture>andesite_casing_short</texture> </up>
          <down> <uv>(0, 0, 2, 1)</uv> <texture>andesite_casing_short</texture> </down>
        </faces>
      </li>
      <li>
        <name>Crank_Grip</name>
        <from>(-0.5, 6.5, 20.5)</from>
        <to>(2.5, 9.5, 26.5)</to>
        <faces>
          <north> <uv>(6, 11, 9, 14)</uv> <rotation>90</rotation> <texture>axis</texture> </north>
          <east> <uv>(7, 1, 10, 7)</uv> <rotation>90</rotation> <texture>axis</texture> </east>
          <south> <uv>(7, 5, 10, 8)</uv> <texture>axis</texture> </south>
          <west> <uv>(7, 1, 10, 7)</uv> <rotation>90</rotation> <texture>axis</texture> </west>
          <up> <uv>(7, 1, 10, 7)</uv> <texture>axis</texture> </up>
          <down> <uv>(7, 1, 10, 7)</uv> <texture>axis</texture> </down>
        </faces>
      </li>
    </elements>
  </GodHandMod.ModelDef>
</Defs>

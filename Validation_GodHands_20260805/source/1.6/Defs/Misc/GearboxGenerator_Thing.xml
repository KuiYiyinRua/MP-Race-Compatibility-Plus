<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 手摇齿轮箱 Job 定义 -->
  <JobDef>
    <defName>GodHand_HandCrankGearbox</defName>
    <driverClass>GodHandMod.JobDriver_HandCrankGearbox</driverClass>
    <reportString>Cranking for power...</reportString>
    <isIdle>true</isIdle>
  </JobDef>

  <!-- 手摇齿轮箱发电机 建筑定义 -->
  <ThingDef ParentName="BuildingBase">
    <defName>GodHand_GearboxGenerator</defName>
    <label>Hand-cranked Gearbox Generator</label>
    <description>A complex mechanical device that converts hand-cranked power into industrial electricity. Composed of a cross gearbox and a large cantilever, it allows pawns to generate power automatically during their leisure time.</description>
    <thingClass>GodHandMod.Building_GearboxGenerator</thingClass>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <graphicData>
      <texPath>CreateAssets/andesite_casing</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <size>(1,1)</size>
    <placeWorkers>
      <li>GodHandMod.PlaceWorker_GearboxGenerator</li>
    </placeWorkers>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <blockLight>false</blockLight>
    <castEdgeShadows>true</castEdgeShadows>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToBuild>2000</WorkToBuild>
      <Flammability>0.5</Flammability>
    </statBases>
    <costList>
      <Steel>50</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerPlant</compClass>
        <basePowerConsumption>0</basePowerConsumption>
        <transmitsPower>true</transmitsPower>
      </li>
      <li Class="CompProperties_Flickable" />
    </comps>
    <rotatable>true</rotatable>
    <designationCategory>RedstoneTech</designationCategory>
    <researchPrerequisites>
      <li>Electricity</li>
    </researchPrerequisites>
  </ThingDef>
</Defs>

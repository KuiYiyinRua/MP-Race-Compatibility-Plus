using UnityEngine;
using Verse;
using RimWorld;
using System;
using System.Reflection;

namespace GodHandMod
{
    /// <summary>
    /// 超精度调整对话框 - 精确调整建筑贴图属性
    /// </summary>
    public class Dialog_PrecisionAdjust : Window
    {
        private Thing targetThing;
        private GraphicTransformManager.TransformData transform;
        
        // 调整参数
        private Vector2 offset;
        private float rotation;
        private Vector3 scale;
        private int drawLayer;
        private int? overrideRot;
        
        // 原始值（用于重置）
        private Vector2 originalOffset;
        private float originalRotation;
        private Vector3 originalScale;
        private int originalDrawLayer;
        private int? originalOverrideRot;
        
        private const float OFFSET_STEP = 0.01f;
        private const float ROTATION_STEP = 1f;
        private const float SCALE_STEP = 0.05f;
        
        public override Vector2 InitialSize => new Vector2(700f, 650f);
        
        protected override float Margin => 10f;
        
        protected override void SetInitialSizeAndPosition()
        {
            // 居中显示
            Vector2 initialSize = InitialSize;
            windowRect = new Rect((UI.screenWidth - initialSize.x) / 2f, (UI.screenHeight - initialSize.y) / 2f, initialSize.x, initialSize.y).Rounded();
        }
        
        public Dialog_PrecisionAdjust(Thing thing)
        {
            this.targetThing = thing;
            this.forcePause = false; // 不暂停游戏，允许实时查看
            this.doCloseX = true;
            this.closeOnClickedOutside = false;
            this.absorbInputAroundWindow = false; // 允许点击外部区域
            this.draggable = true; // 允许拖动
            
            GodHandModMain.DebugLog($"[超精调整] 目标: {thing.LabelCap}, 类型: {thing.GetType().Name}");
            
            // 使用全局管理器，支持所有类型的Thing
            transform = GraphicTransformManager.GetOrCreate(thing);
            
            // 加载当前值
            offset = transform.offset;
            rotation = transform.rotation;
            scale = transform.scale;
            drawLayer = transform.drawLayer;
            overrideRot = transform.overrideRot;
            
            GodHandModMain.DebugLog($"[超精调整] 当前值: offset={offset}, rotation={rotation}, scale={scale}, layer={drawLayer}, overrideRot={overrideRot}");
            
            // 保存原始值
            originalOffset = offset;
            originalRotation = rotation;
            originalScale = scale;
            originalDrawLayer = drawLayer;
            originalOverrideRot = overrideRot;
        }
        
        public override void DoWindowContents(Rect inRect)
        {
            Listing_Standard listing = new Listing_Standard();
            listing.Begin(inRect);
            
            // 标题
            Text.Font = GameFont.Medium;
            listing.Label("GodHand.Wrench.PrecisionAdjustTitle".Translate(targetThing.LabelCap));
            Text.Font = GameFont.Small;
            listing.Gap();
            
            // === 位置偏移 ===
            listing.Label("GodHand.Wrench.Offset".Translate() + $": ({offset.x:F3}, {offset.y:F3})");
            
            // X偏移
            Rect offsetXBtnRect = listing.GetRect(30f);
            if (Widgets.ButtonText(offsetXBtnRect, $"X: {offset.x:F3}"))
            {
                Find.WindowStack.Add(new Dialog_NumericInput(offset.x, (val) => {
                    offset.x = val;
                    ApplyChanges();
                }, "X"));
            }
            
            Rect offsetXSliderRect = listing.GetRect(25f);
            float newOffsetX = Widgets.HorizontalSlider(offsetXSliderRect, offset.x, -5f, 5f, false);
            if (Mathf.Abs(newOffsetX - offset.x) > 0.001f)
            {
                offset.x = newOffsetX;
                ApplyChanges();
            }
            
            // Y偏移
            Rect offsetYBtnRect = listing.GetRect(30f);
            if (Widgets.ButtonText(offsetYBtnRect, $"Y: {offset.y:F3}"))
            {
                Find.WindowStack.Add(new Dialog_NumericInput(offset.y, (val) => {
                    offset.y = val;
                    ApplyChanges();
                }, "Y"));
            }
            
            Rect offsetYSliderRect = listing.GetRect(25f);
            float newOffsetY = Widgets.HorizontalSlider(offsetYSliderRect, offset.y, -5f, 5f, false);
            if (Mathf.Abs(newOffsetY - offset.y) > 0.001f)
            {
                offset.y = newOffsetY;
                ApplyChanges();
            }
            
            listing.Gap();
            
            // === 旋转 ===
            listing.Label("GodHand.Wrench.Rotation".Translate() + $": {rotation:F1}°");
            
            // 旋转输入框
            Rect rotBtnRect = listing.GetRect(30f);
            if (Widgets.ButtonText(rotBtnRect, rotation.ToString("F1") + "°"))
            {
                Find.WindowStack.Add(new Dialog_NumericInput(rotation, (val) => {
                    rotation = val;
                    ApplyChanges();
                }, "GodHand.Wrench.Rotation".Translate()));
            }
            
            // 旋转滑条
            Rect rotSliderRect = listing.GetRect(25f);
            float newRot = Widgets.HorizontalSlider(rotSliderRect, rotation, -180f, 180f, false);
            if (Mathf.Abs(newRot - rotation) > 0.1f)
            {
                rotation = newRot;
                ApplyChanges();
            }
            
            // 快捷旋转按钮
            Rect rotQuickRect = listing.GetRect(30f);
            Rect rotLeftRect = new Rect(rotQuickRect.x, rotQuickRect.y, rotQuickRect.width / 3 - 5f, 30f);
            Rect rotResetRect = new Rect(rotQuickRect.x + rotQuickRect.width / 3 + 5f, rotQuickRect.y, rotQuickRect.width / 3 - 5f, 30f);
            Rect rotRightRect = new Rect(rotQuickRect.x + rotQuickRect.width * 2 / 3 + 10f, rotQuickRect.y, rotQuickRect.width / 3 - 5f, 30f);
            
            if (Widgets.ButtonText(rotLeftRect, "-90°"))
            {
                rotation -= 90f;
                ApplyChanges();
            }
            if (Widgets.ButtonText(rotResetRect, "0°"))
            {
                rotation = 0f;
                ApplyChanges();
            }
            if (Widgets.ButtonText(rotRightRect, "+90°"))
            {
                rotation += 90f;
                ApplyChanges();
            }
            
            // 规范化角度
            while (rotation > 180f) rotation -= 360f;
            while (rotation < -180f) rotation += 360f;
            
            listing.Gap();
            
            // === 贴图朝向 ===
            string orientLabel = overrideRot.HasValue ? new Rot4(overrideRot.Value).ToStringHuman() : "GodHand.Wrench.Auto".Translate().ToString();
            listing.Label("GodHand.Wrench.TextureOrientation".Translate() + $": {orientLabel}");
            
            Rect orientRect = listing.GetRect(30f);
            float btnW = orientRect.width / 5f;
            
            if (Widgets.ButtonText(new Rect(orientRect.x, orientRect.y, btnW, 30f), "GodHand.Wrench.Auto".Translate())) { overrideRot = null; ApplyChanges(); }
            if (Widgets.ButtonText(new Rect(orientRect.x + btnW, orientRect.y, btnW, 30f), "N")) { overrideRot = 0; ApplyChanges(); }
            if (Widgets.ButtonText(new Rect(orientRect.x + btnW * 2, orientRect.y, btnW, 30f), "E")) { overrideRot = 1; ApplyChanges(); }
            if (Widgets.ButtonText(new Rect(orientRect.x + btnW * 3, orientRect.y, btnW, 30f), "S")) { overrideRot = 2; ApplyChanges(); }
            if (Widgets.ButtonText(new Rect(orientRect.x + btnW * 4, orientRect.y, btnW, 30f), "W")) { overrideRot = 3; ApplyChanges(); }
            
            listing.Gap();
            
            // === 缩放 ===
            listing.Label("GodHand.Wrench.Scale".Translate() + $": ({scale.x:F2}, {scale.y:F2}, {scale.z:F2})");
            
            // X缩放
            Rect scaleXBtnRect = listing.GetRect(30f);
            if (Widgets.ButtonText(scaleXBtnRect, $"X: {scale.x:F2}"))
            {
                Find.WindowStack.Add(new Dialog_NumericInput(scale.x, (val) => {
                    scale.x = val;
                    ApplyChanges();
                }, "X"));
            }
            
            Rect scaleXSliderRect = listing.GetRect(25f);
            float newScaleX = Widgets.HorizontalSlider(scaleXSliderRect, scale.x, 0.1f, 10f, false);
            if (Mathf.Abs(newScaleX - scale.x) > 0.01f)
            {
                scale.x = newScaleX;
                ApplyChanges();
            }
            
            // Y缩放
            Rect scaleYBtnRect = listing.GetRect(30f);
            if (Widgets.ButtonText(scaleYBtnRect, $"Y: {scale.y:F2}"))
            {
                Find.WindowStack.Add(new Dialog_NumericInput(scale.y, (val) => {
                    scale.y = val;
                    ApplyChanges();
                }, "Y"));
            }
            
            Rect scaleYSliderRect = listing.GetRect(25f);
            float newScaleY = Widgets.HorizontalSlider(scaleYSliderRect, scale.y, 0.1f, 10f, false);
            if (Mathf.Abs(newScaleY - scale.y) > 0.01f)
            {
                scale.y = newScaleY;
                ApplyChanges();
            }
            
            // Z缩放
            Rect scaleZBtnRect = listing.GetRect(30f);
            if (Widgets.ButtonText(scaleZBtnRect, $"Z: {scale.z:F2}"))
            {
                Find.WindowStack.Add(new Dialog_NumericInput(scale.z, (val) => {
                    scale.z = val;
                    ApplyChanges();
                }, "Z"));
            }
            
            Rect scaleZSliderRect = listing.GetRect(25f);
            float newScaleZ = Widgets.HorizontalSlider(scaleZSliderRect, scale.z, 0.1f, 10f, false);
            if (Mathf.Abs(newScaleZ - scale.z) > 0.01f)
            {
                scale.z = newScaleZ;
                ApplyChanges();
            }
            
            listing.Gap();
            
            // === 渲染层 ===
            listing.Label("GodHand.Wrench.DrawLayer".Translate() + $": {drawLayer}");
            
            // 层级输入框
            Rect layerBtnRect = listing.GetRect(30f);
            if (Widgets.ButtonText(layerBtnRect, drawLayer.ToString()))
            {
                Find.WindowStack.Add(new Dialog_NumericInput(drawLayer, (val) => {
                    drawLayer = (int)val;
                    ApplyChanges();
                }, "GodHand.Wrench.DrawLayer".Translate()));
            }
            
            // 层级滑条
            Rect layerSliderRect = listing.GetRect(25f);
            int newLayer = (int)Widgets.HorizontalSlider(layerSliderRect, drawLayer, -10, 10, false);
            if (newLayer != drawLayer)
            {
                drawLayer = newLayer;
                ApplyChanges();
            }
            
            listing.Gap(12f);
            
            // === 炮塔特殊调整 ===
            if (targetThing is Building_Turret turret)
            {
                listing.Label("GodHand.Wrench.TurretSettings".Translate());
                listing.Gap(6f);
                
                // 炮筒旋转
                object turretTop = GetTurretTop(turret);
                if (turretTop != null)
                {
                    float curRotation = GetTurretRotation(turretTop);
                    
                    Rect turretRotLabelRect = listing.GetRect(25f);
                    Widgets.Label(turretRotLabelRect, "GodHand.Wrench.TurretRotation".Translate(curRotation.ToString("F1")));
                    
                    Rect turretRotSliderRect = listing.GetRect(25f);
                    float newTurretRot = Widgets.HorizontalSlider(turretRotSliderRect, curRotation, 0f, 360f, false);
                    if (Mathf.Abs(newTurretRot - curRotation) > 0.1f)
                    {
                        SetTurretRotation(turretTop, newTurretRot);
                    }
                    
                    // 快捷旋转按钮
                    Rect turretQuickRect = listing.GetRect(30f);
                    float btnWidth = turretQuickRect.width / 4f;
                    if (Widgets.ButtonText(new Rect(turretQuickRect.x, turretQuickRect.y, btnWidth - 2f, 30f), "0°"))
                    {
                        SetTurretRotation(turretTop, 0f);
                    }
                    if (Widgets.ButtonText(new Rect(turretQuickRect.x + btnWidth, turretQuickRect.y, btnWidth - 2f, 30f), "90°"))
                    {
                        SetTurretRotation(turretTop, 90f);
                    }
                    if (Widgets.ButtonText(new Rect(turretQuickRect.x + btnWidth * 2, turretQuickRect.y, btnWidth - 2f, 30f), "180°"))
                    {
                        SetTurretRotation(turretTop, 180f);
                    }
                    if (Widgets.ButtonText(new Rect(turretQuickRect.x + btnWidth * 3, turretQuickRect.y, btnWidth - 2f, 30f), "270°"))
                    {
                        SetTurretRotation(turretTop, 270f);
                    }
                }
                
                listing.Gap(12f);
            }
            
            // === 高级渲染编辑 ===
            // 检测是否为Pawn - 如果是，提供渲染树编辑器
            if (targetThing is Pawn pawn)
            {
                listing.Gap(6f);
                Rect advancedRect = listing.GetRect(35f);
                if (Widgets.ButtonText(advancedRect, "GodHand.Wrench.OpenRenderTreeEditor".Translate()))
                {
                    Find.WindowStack.Add(new Dialog_PlasticSurgeryGodHand(pawn));
                }
                Text.Anchor = TextAnchor.MiddleCenter;
                GUI.color = ColoredText.SubtleGrayColor;
                Rect hintRect = listing.GetRect(20f);
                Widgets.Label(hintRect, "GodHand.Wrench.RenderTreeEditorHint".Translate());
                GUI.color = Color.white;
                Text.Anchor = TextAnchor.UpperLeft;
            }
            
            listing.Gap(12f);
            
            // === 底部按钮 ===
            Rect bottomRect = listing.GetRect(30f);
            Rect resetRect = new Rect(bottomRect.x, bottomRect.y, bottomRect.width / 2 - 5f, 30f);
            Rect closeRect = new Rect(bottomRect.x + bottomRect.width / 2 + 5f, bottomRect.y, bottomRect.width / 2 - 5f, 30f);
            
            if (Widgets.ButtonText(resetRect, "GodHand.Wrench.ResetAll".Translate()))
            {
                ResetToOriginal();
            }
            
            if (Widgets.ButtonText(closeRect, "CloseButton".Translate()))
            {
                Close();
            }
            
            listing.End();
        }
        
        
        private void ApplyChanges()
        {
            if (transform != null && targetThing != null)
            {
                GodHandModMain.DebugLog($"[超精调整] 应用变换: offset={offset}, rotation={rotation}, scale={scale}, layer={drawLayer}, overrideRot={overrideRot}");
                
                GraphicTransformManager.Set(targetThing, offset, rotation, scale, drawLayer, overrideRot);
                
                // 强制重绘（测试用）
                if (targetThing.Spawned && targetThing.Map != null)
                {
                    targetThing.Map.mapDrawer.MapMeshDirty(targetThing.Position, RimWorld.MapMeshFlagDefOf.Things);
                    targetThing.Map.mapDrawer.MapMeshDirty(targetThing.Position, RimWorld.MapMeshFlagDefOf.Buildings);
                    GodHandModMain.DebugLog($"[超精调整] 已标记重绘: {targetThing.Position}");
                }
            }
        }
        
        private void ResetToOriginal()
        {
            offset = originalOffset;
            rotation = originalRotation;
            scale = originalScale;
            drawLayer = originalDrawLayer;
            overrideRot = originalOverrideRot;
            
            ApplyChanges();
        }
        
        // === 炮塔反射方法 ===
        private static FieldInfo turretTopField;
        private static PropertyInfo curRotationProperty;
        
        private object GetTurretTop(Building_Turret turret)
        {
            try
            {
                if (turretTopField == null)
                {
                    turretTopField = typeof(Building_Turret).GetField("top", BindingFlags.Instance | BindingFlags.NonPublic);
                }
                return turretTopField?.GetValue(turret);
            }
            catch
            {
                return null;
            }
        }
        
        private float GetTurretRotation(object turretTop)
        {
            try
            {
                if (curRotationProperty == null)
                {
                    curRotationProperty = turretTop.GetType().GetProperty("CurRotation");
                }
                return (float)(curRotationProperty?.GetValue(turretTop) ?? 0f);
            }
            catch
            {
                return 0f;
            }
        }
        
        private void SetTurretRotation(object turretTop, float rotation)
        {
            try
            {
                if (curRotationProperty == null)
                {
                    curRotationProperty = turretTop.GetType().GetProperty("CurRotation");
                }
                curRotationProperty?.SetValue(turretTop, rotation);
            }
            catch (Exception ex)
            {
                GodHandModMain.DebugLog($"[超精调整] 设置炮塔旋转失败: {ex.Message}");
            }
        }
    }
    
    /// <summary>
    /// 数值输入对话框 - 无限制输入
    /// </summary>
    public class Dialog_NumericInput : Window
    {
        private string buffer;
        private Action<float> callback;
        private string paramName;
        
        public override Vector2 InitialSize => new Vector2(280f, 150f);
        
        public Dialog_NumericInput(float initial, Action<float> callback, string paramName = "")
        {
            this.buffer = initial.ToString("F3");
            this.callback = callback;
            this.paramName = paramName;
            this.forcePause = false;
            this.closeOnClickedOutside = true;
            this.doCloseButton = false;
        }
        
        public override void DoWindowContents(Rect inRect)
        {
            Listing_Standard listing = new Listing_Standard();
            listing.Begin(inRect);
            
            string prompt = string.IsNullOrEmpty(paramName) 
                ? "GodHand.Wrench.EnterValueUnlimited".Translate()
                : "GodHand.Wrench.EnterValueFor".Translate(paramName);
            listing.Label(prompt);
            buffer = listing.TextEntry(buffer);
            
            Rect btnRect = listing.GetRect(30f);
            Rect okRect = new Rect(btnRect.x, btnRect.y, btnRect.width / 2 - 5f, 30f);
            Rect cancelRect = new Rect(btnRect.x + btnRect.width / 2 + 5f, btnRect.y, btnRect.width / 2 - 5f, 30f);
            
            if (Widgets.ButtonText(okRect, "OK".Translate()))
            {
                if (float.TryParse(buffer, out float value))
                {
                    // 无限制，允许任意值
                    callback?.Invoke(value);
                    Close();
                }
            }
            
            if (Widgets.ButtonText(cancelRect, "CancelButton".Translate()))
            {
                Close();
            }
            
            listing.End();
        }
    }
}
